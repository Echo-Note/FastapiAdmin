# 生产环境变量
# 在生产构建时使用 (npm run build)

# API 基础 URL - 生产环境
# 同源部署：留空走相对路径 /api/v1，由 Caddy 在 wxh5.xfoxlab.com.cn 反代到 backend:8001，
# 避免跨域（此前指向 service.fastapiadmin.com 会触发 CORS preflight 被拒）。
VITE_API_BASE_URL=

# 环境名称
VITE_ENV_NAME=production

# 项目名称
VITE_APP_TITLE=fastapiadmin

# 代理前缀
VITE_APP_BASE_API=/api/v1

# 应用端口
VITE_APP_PORT=5180

# 超时时间
VITE_TIMEOUT=10000

# WebSocket 服务器的 URL，不配置默认关闭 WebSocket
# 只填基址，业务路径由代码拼接：{VITE_APP_WS_ENDPOINT}{VITE_APP_BASE_API}/ai/chat/ws
# 站点为 HTTPS，必须使用 wss，否则会被浏览器/小程序平台拦截
# 同源 WebSocket：经 Caddy 反代 /api/v1 自动升级，避免跨域
VITE_APP_WS_ENDPOINT=wss://wxh5.xfoxlab.com.cn
