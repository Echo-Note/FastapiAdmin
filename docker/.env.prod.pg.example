# ============================================================
# FoxWork 线上环境变量示例（连接腾讯云内网 PostgreSQL / Redis）
# 用法：cp .env.prod.pg.example .env.prod.pg，填入真实值
# 注意：本文件会提交到仓库，只放占位符；真实口令写入 .env.prod.pg（不入库）
# ============================================================

# ---------- PostgreSQL（腾讯云内网实例 172.30.0.8）----------
DATABASE_HOST=172.30.0.8
DATABASE_PORT=5432
DATABASE_USER=xfoxlab
DATABASE_PASSWORD=change_me_pg_password
DATABASE_NAME=foxwork

# ---------- Redis（腾讯云内网实例 172.30.0.48）----------
REDIS_HOST=172.30.0.48
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---------- 后端 ----------
BACKEND_IMAGE_TAG=latest
BACKEND_PORT=8001
LOGGER_LEVEL=INFO
# 运行环境，固定 prod
DEPLOY_ENV=prod
# 生产禁止启动时自动建表/迁移/播种（false）；首次部署与升级用 docker exec 手动执行：
#   docker compose --env-file .env.prod.pg -f docker-compose.prod.pg.yaml exec backend python main.py init --env=prod
AUTO_INIT_DB=false

# ---------- 安全（生产必填，禁止用示例值）----------
# 令牌签名密钥：openssl rand -hex 32（更换后所有已签发令牌失效）
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
# 落库敏感数据加密主密钥：openssl rand -hex 32；留空则由 SECRET_KEY 派生
DATA_ENCRYPTION_KEY=
# 轮换前的旧主密钥（逗号分隔），仅用于解密历史密文
DATA_ENCRYPTION_OLD_KEYS=

# ---------- 域名 / Host 校验 / CORS ----------
# ⚠️ list[str] 字段必须用 JSON 数组字面量，写成逗号分隔字符串会导致启动失败
ALLOWED_HOSTS=["admin.xfoxlab.com.cn","wxh5.xfoxlab.com.cn"]
OAUTH_ALLOWED_HOSTS=["admin.xfoxlab.com.cn","wxh5.xfoxlab.com.cn"]
# 生产跨域白名单（str，逗号分隔）
PROD_CORS_ORIGINS=https://admin.xfoxlab.com.cn,https://wxh5.xfoxlab.com.cn
CORS_STRICT_STARTUP=false

# ---------- 其它 ----------
# 演示模式：true 禁止写操作；生产可写需 false
DEMO_ENABLE=false
# 定时任务代码块执行（等同 RCE，生产保持 false）
SCHEDULER_ALLOW_CODE_EXEC=false

# ---------- 端口 ----------
HTTP_PORT=80
HTTPS_PORT=443
